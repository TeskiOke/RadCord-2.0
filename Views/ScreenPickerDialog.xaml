<Window x:Class="RadCord.Views.ScreenPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выберите источник трансляции"
        Height="500" Width="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgMidBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Трансляция экрана" FontSize="20" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16"/>

        <!-- Quality / FPS -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="КАЧЕСТВО" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <ComboBox x:Name="QualityCombo" Style="{StaticResource DiscordComboBox}"
                          Padding="10,6" FontSize="13"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="FPS" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <ComboBox x:Name="FpsCombo" Style="{StaticResource DiscordComboBox}"
                          Padding="10,6" FontSize="13"/>
            </StackPanel>
        </Grid>

        <!-- Tab: Monitors / Windows -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="TabMonitor" Content="Экраны" Style="{StaticResource AccentButton}"
                    Padding="16,6" Margin="0,0,8,0" Click="TabMonitor_Click"/>
            <Button x:Name="TabWindow" Content="Окна" Style="{StaticResource GhostButton}"
                    Padding="16,6" Click="TabWindow_Click"/>
        </StackPanel>

        <!-- Source list -->
        <Border Grid.Row="3" Background="{StaticResource BgDarkBrush}" CornerRadius="6">
            <ListBox x:Name="SourceList" Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource TextPrimaryBrush}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="FontSize" Value="13"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <!-- Audio option -->
        <CheckBox Grid.Row="4" x:Name="IncludeAudio" Content="Включить системный звук (WASAPI Loopback)"
                  Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"
                  IsChecked="False" Margin="0,12,0,0"/>

        <!-- Buttons -->
        <Grid Grid.Row="5" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Отмена"
                    Style="{StaticResource GhostButton}" Padding="0,12" Margin="0,0,4,0"
                    Click="Cancel_Click"/>
            <Button Grid.Column="1" Content="Начать трансляцию"
                    Style="{StaticResource AccentButton}" Padding="0,12" Margin="4,0,0,0"
                    Click="Start_Click"/>
        </Grid>
    </Grid>
</Window>
