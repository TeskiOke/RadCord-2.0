<Window x:Class="RadCord.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RadCord"
        Width="460" SizeToContent="Height"
        MinHeight="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgMidBrush}">

    <StackPanel Margin="40,36,40,40">

        <!-- ── Header ─────────────────────────────────────────────── -->
        <TextBlock Text="Добро пожаловать!" FontSize="24" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   HorizontalAlignment="Center" Margin="0,0,0,6"/>
        <TextBlock Text="Настройте свой профиль перед входом"
                   FontSize="13" Foreground="{StaticResource TextMutedBrush}"
                   HorizontalAlignment="Center" Margin="0,0,0,32"/>

        <!-- ── Avatar preview ─────────────────────────────────────── -->
        <Grid HorizontalAlignment="Center" Margin="0,0,0,28">
            <Ellipse x:Name="AvatarEllipse" Width="80" Height="80">
                <Ellipse.Fill><SolidColorBrush x:Name="AvatarFill" Color="#FF5865F2"/></Ellipse.Fill>
            </Ellipse>
            <TextBlock x:Name="AvatarInitial" Text="?" FontSize="32" FontWeight="Bold"
                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- ── Nickname ───────────────────────────────────────────── -->
        <TextBlock Text="КАК ВАС ЗОВУТ?" FontSize="11" FontWeight="SemiBold"
                   Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
        <Border Background="{StaticResource BgInputBrush}" CornerRadius="4" Margin="0,0,0,4">
            <TextBox x:Name="NicknameBox"
                     Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     CaretBrush="{StaticResource TextPrimaryBrush}"
                     SelectionBrush="{StaticResource AccentBrush}"
                     FontSize="15" Padding="12,10"
                     MaxLength="32"
                     TextChanged="NicknameBox_TextChanged"/>
        </Border>
        <TextBlock x:Name="NickHint" Text="Минимум 2 символа"
                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="2,2,0,0"/>

        <!-- ── Color picker ───────────────────────────────────────── -->
        <TextBlock Text="ЦВЕТ АВАТАРА" FontSize="11" FontWeight="SemiBold"
                   Foreground="{StaticResource TextMutedBrush}" Margin="0,20,0,10"/>
        <WrapPanel x:Name="ColorPanel"/>

        <!-- ── Error ──────────────────────────────────────────────── -->
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource RedBrush}"
                   FontSize="12" Margin="0,12,0,0" Visibility="Collapsed"/>

        <!-- ── Action ─────────────────────────────────────────────── -->
        <Button x:Name="StartBtn" Content="Начать" Margin="0,24,0,0"
                Style="{StaticResource AccentButton}"
                FontSize="15" Padding="0,13"
                IsEnabled="False"
                Click="Start_Click"/>

    </StackPanel>
</Window>
