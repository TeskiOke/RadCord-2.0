<Window x:Class="RadCord.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки RadCord" Height="620" Width="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgMidBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left nav -->
        <Border Grid.Column="0" Background="{DynamicResource BgDarkBrush}">
            <StackPanel Margin="8,16,8,8">
                <TextBlock Text="НАСТРОЙКИ" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,8"/>
                <Button x:Name="NavProfile" Content="Профиль"
                        Style="{StaticResource GhostButton}"
                        HorizontalContentAlignment="Left"
                        Padding="8,8" Margin="0,2"
                        Click="Nav_Click" Tag="Profile"/>
                <Button x:Name="NavAudio" Content="Голос и аудио"
                        Style="{StaticResource AccentButton}"
                        HorizontalContentAlignment="Left"
                        Padding="8,8" Margin="0,2"
                        Click="Nav_Click" Tag="Audio"/>
                <Button x:Name="NavBinds" Content="Бинды"
                        Style="{StaticResource GhostButton}"
                        HorizontalContentAlignment="Left"
                        Padding="8,8" Margin="0,2"
                        Click="Nav_Click" Tag="Binds"/>
            </StackPanel>
        </Border>

        <!-- Content pages -->
        <ScrollViewer Grid.Column="1" Margin="24">
            <StackPanel>

                <!-- ── PROFILE ──────────────────────────────────────── -->
                <StackPanel x:Name="PageProfile" Visibility="Collapsed">
                    <TextBlock Text="Профиль" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,24"/>

                    <TextBlock Text="НИКНЕЙМ" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <TextBox x:Name="NickBox" Style="{StaticResource DiscordTextBox}"
                             MaxLength="32" Padding="12,10" FontSize="14"/>

                    <!-- Avatar color RGB -->
                    <TextBlock Text="ЦВЕТ АВАТАРА" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,20,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Left" Text="R" Width="18"
                                           Foreground="#E74C3C" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="AvatarRLabel" DockPanel.Dock="Right" Width="32"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextAlignment="Right" VerticalAlignment="Center"/>
                                <Slider x:Name="AvatarRSlider" Minimum="0" Maximum="255"
                                        Background="#E74C3C"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource DiscordSlider}"
                                        ValueChanged="AvatarRGB_Changed"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Left" Text="G" Width="18"
                                           Foreground="#2ECC71" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="AvatarGLabel" DockPanel.Dock="Right" Width="32"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextAlignment="Right" VerticalAlignment="Center"/>
                                <Slider x:Name="AvatarGSlider" Minimum="0" Maximum="255"
                                        Background="#2ECC71"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource DiscordSlider}"
                                        ValueChanged="AvatarRGB_Changed"/>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="B" Width="18"
                                           Foreground="#3498DB" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="AvatarBLabel" DockPanel.Dock="Right" Width="32"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextAlignment="Right" VerticalAlignment="Center"/>
                                <Slider x:Name="AvatarBSlider" Minimum="0" Maximum="255"
                                        Background="#3498DB"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource DiscordSlider}"
                                        ValueChanged="AvatarRGB_Changed"/>
                            </DockPanel>
                        </StackPanel>
                        <Ellipse x:Name="AvatarColorPreview" Grid.Column="1"
                                 Width="44" Height="44" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- App accent color RGB -->
                    <TextBlock Text="ЦВЕТ ИНТЕРФЕЙСА" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,20,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Left" Text="R" Width="18"
                                           Foreground="#E74C3C" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="AccentRLabel" DockPanel.Dock="Right" Width="32"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextAlignment="Right" VerticalAlignment="Center"/>
                                <Slider x:Name="AccentRSlider" Minimum="0" Maximum="255"
                                        Background="#E74C3C"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource DiscordSlider}"
                                        ValueChanged="AccentRGB_Changed"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Left" Text="G" Width="18"
                                           Foreground="#2ECC71" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="AccentGLabel" DockPanel.Dock="Right" Width="32"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextAlignment="Right" VerticalAlignment="Center"/>
                                <Slider x:Name="AccentGSlider" Minimum="0" Maximum="255"
                                        Background="#2ECC71"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource DiscordSlider}"
                                        ValueChanged="AccentRGB_Changed"/>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="B" Width="18"
                                           Foreground="#3498DB" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="AccentBLabel" DockPanel.Dock="Right" Width="32"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextAlignment="Right" VerticalAlignment="Center"/>
                                <Slider x:Name="AccentBSlider" Minimum="0" Maximum="255"
                                        Background="#3498DB"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource DiscordSlider}"
                                        ValueChanged="AccentRGB_Changed"/>
                            </DockPanel>
                        </StackPanel>
                        <Border x:Name="AccentColorPreview" Grid.Column="1"
                                Width="44" Height="44" CornerRadius="8"
                                Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- App theme -->
                    <TextBlock Text="ТЕМА ИНТЕРФЕЙСА" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,20,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RbDark" Content="Тёмная" GroupName="AppTheme"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Margin="0,0,16,0" Checked="Theme_Checked"/>
                        <RadioButton x:Name="RbGray" Content="Серая" GroupName="AppTheme"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Margin="0,0,16,0" Checked="Theme_Checked"/>
                        <RadioButton x:Name="RbLight" Content="Светлая" GroupName="AppTheme"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Checked="Theme_Checked"/>
                    </StackPanel>

                    <Button Content="Сохранить профиль"
                            Style="{StaticResource AccentButton}"
                            Padding="20,10" Margin="0,24,0,0"
                            HorizontalAlignment="Left"
                            Click="SaveProfile_Click"/>
                </StackPanel>

                <!-- ── AUDIO ─────────────────────────────────────────── -->
                <StackPanel x:Name="PageAudio" Visibility="Visible">
                    <TextBlock Text="Голос и аудио" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,24"/>

                    <TextBlock Text="УСТРОЙСТВО ВВОДА (МИКРОФОН)" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="InputDeviceCombo" Style="{StaticResource DiscordComboBox}"
                              Padding="12,8" FontSize="14"
                              SelectionChanged="AudioDevice_Changed"/>

                    <TextBlock Text="УСТРОЙСТВО ВЫВОДА (ДИНАМИКИ)" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,16,0,6"/>
                    <ComboBox x:Name="OutputDeviceCombo" Style="{StaticResource DiscordComboBox}"
                              Padding="12,8" FontSize="14"
                              SelectionChanged="AudioDevice_Changed"/>

                    <TextBlock Text="ПОРОГ VAD (ЧУВСТВИТЕЛЬНОСТЬ МИКРОФОНА)" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,20,0,8"/>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock x:Name="VadLabel" DockPanel.Dock="Right" Width="52"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                                   VerticalAlignment="Center" TextAlignment="Right"/>
                        <Slider x:Name="VadSlider" Style="{StaticResource DiscordSlider}"
                                Minimum="0" Maximum="100" TickFrequency="1"
                                ValueChanged="VadSlider_ValueChanged"/>
                    </DockPanel>
                    <ToggleButton x:Name="VadDisableBtn"
                                  Content="Выключить VAD (всегда говорить)"
                                  Padding="14,8" FontSize="13"
                                  HorizontalAlignment="Left"
                                  Checked="VadDisable_Changed" Unchecked="VadDisable_Changed">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="{DynamicResource BgLightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Background" Value="{StaticResource GreenBrush}"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                    <!-- Mic test meter -->
                    <TextBlock Text="ТЕСТ МИКРОФОНА" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,20,0,8"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="16" Background="{DynamicResource BgLightBrush}"
                                CornerRadius="8" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Border x:Name="MicMeter" HorizontalAlignment="Left"
                                    Height="16" Width="0" CornerRadius="8"
                                    Background="{DynamicResource GreenBrush}"/>
                        </Border>
                        <ToggleButton x:Name="MicTestBtn" Grid.Column="1"
                                      Content="▶  Тест"
                                      Height="32"
                                      Background="{DynamicResource BgLightBrush}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      BorderThickness="1"
                                      BorderBrush="{DynamicResource BgLightBrush}"
                                      Padding="10,0"
                                      FontSize="13"
                                      Cursor="Hand"
                                      Checked="MicTest_Checked" Unchecked="MicTest_Unchecked">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bg" Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource GreenBrush}"/>
                                            <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource GreenBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </Grid>

                    <Separator Background="{DynamicResource SeparatorBrush}" Margin="0,20"/>

                    <TextBlock Text="ГРОМКОСТЬ" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>

                    <TextBlock Text="Общая" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="13" Margin="0,0,0,4"/>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock x:Name="MasterVolLabel" DockPanel.Dock="Right" Width="52"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                                   VerticalAlignment="Center" TextAlignment="Right"/>
                        <Slider x:Name="MasterVolSlider" Style="{StaticResource DiscordSlider}"
                                Minimum="0" Maximum="200" Value="100"
                                ValueChanged="MasterVol_Changed"/>
                    </DockPanel>

                    <TextBlock Text="Голос участников" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="13" Margin="0,0,0,4"/>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock x:Name="PeersVolLabel" DockPanel.Dock="Right" Width="52"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                                   VerticalAlignment="Center" TextAlignment="Right"/>
                        <Slider x:Name="PeersVolSlider" Style="{StaticResource DiscordSlider}"
                                Minimum="0" Maximum="200" Value="100"
                                ValueChanged="PeersVol_Changed"/>
                    </DockPanel>

                    <TextBlock Text="Стримы" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="13" Margin="0,0,0,4"/>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock x:Name="StreamVolLabel" DockPanel.Dock="Right" Width="52"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                                   VerticalAlignment="Center" TextAlignment="Right"/>
                        <Slider x:Name="StreamVolSlider" Style="{StaticResource DiscordSlider}"
                                Minimum="0" Maximum="200" Value="100"
                                ValueChanged="StreamVol_Changed"/>
                    </DockPanel>

                    <TextBlock Text="Звуковые уведомления" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="13" Margin="0,0,0,4"/>
                    <DockPanel>
                        <TextBlock x:Name="NotifVolLabel" DockPanel.Dock="Right" Width="52"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                                   VerticalAlignment="Center" TextAlignment="Right"/>
                        <Slider x:Name="NotifVolSlider" Style="{StaticResource DiscordSlider}"
                                Minimum="0" Maximum="100" Value="100"
                                ValueChanged="NotifVol_Changed"/>
                    </DockPanel>

                </StackPanel>

                <!-- ── BINDS ─────────────────────────────────────────── -->
                <StackPanel x:Name="PageBinds" Visibility="Collapsed">
                    <TextBlock Text="Бинды" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,24"/>

                    <TextBlock Text="КНОПКА РАЗГОВОРА (PTT)" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                    <TextBlock Text="Удерживайте назначенную клавишу для передачи голоса."
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource BgLightBrush}" CornerRadius="6"
                                Padding="14,10" Margin="0,0,10,0">
                            <TextBlock x:Name="PttKeyLabel" Text="Не назначено"
                                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"/>
                        </Border>
                        <Button x:Name="CapturePttBtn" Grid.Column="1"
                                Content="Назначить"
                                Style="{StaticResource AccentButton}"
                                Padding="0,10"
                                Click="CapturePtt_Click"/>
                    </Grid>

                    <TextBlock Text="БИНД МУТА МИКРОФОНА" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,24,0,8"/>
                    <TextBlock Text="Переключает мут микрофона (вы не будете слышны другим)."
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource BgLightBrush}" CornerRadius="6"
                                Padding="14,10" Margin="0,0,10,0">
                            <TextBlock x:Name="MicMuteKeyLabel" Text="Не назначено"
                                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"/>
                        </Border>
                        <Button x:Name="CaptureMicMuteBtn" Grid.Column="1"
                                Content="Назначить"
                                Style="{StaticResource AccentButton}"
                                Padding="0,10"
                                Click="CaptureMicMute_Click"/>
                    </Grid>

                    <TextBlock Text="БИНД ДЕАФЕНА (ПОЛНЫЙ МУТ)" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,24,0,8"/>
                    <TextBlock Text="Переключает деафен: вы не слышите других и не передаёте звук."
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource BgLightBrush}" CornerRadius="6"
                                Padding="14,10" Margin="0,0,10,0">
                            <TextBlock x:Name="MuteKeyLabel" Text="Не назначено"
                                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"/>
                        </Border>
                        <Button x:Name="CaptureMuteBtn" Grid.Column="1"
                                Content="Назначить"
                                Style="{StaticResource AccentButton}"
                                Padding="0,10"
                                Click="CaptureMute_Click"/>
                    </Grid>

                    <TextBlock Text="После назначения клавиши нажмите её, когда находитесь в главном окне."
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,24,0,0"/>

                    <TextBlock Text="РЕЖИМ АКТИВАЦИИ МИКРОФОНА" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,28,0,8"/>
                    <StackPanel>
                        <RadioButton x:Name="RbVad" GroupName="VoiceMode"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Margin="0,0,0,8" Checked="VoiceMode_Changed">
                            <StackPanel>
                                <TextBlock Text="Активация по голосу (VAD)"
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"/>
                                <TextBlock Text="Микрофон передаёт звук автоматически при превышении порога."
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="RbPtt" GroupName="VoiceMode"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     Checked="VoiceMode_Changed">
                            <StackPanel>
                                <TextBlock Text="Нажми для разговора (PTT)"
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14"/>
                                <TextBlock Text="Удерживай назначенную клавишу/кнопку чтобы говорить."
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
