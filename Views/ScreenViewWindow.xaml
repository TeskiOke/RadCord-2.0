<Window x:Class="RadCord.Views.ScreenViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Трансляция экрана" Height="280" Width="400"
        Background="Black" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        SourceInitialized="Window_SourceInitialized">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="44"/>
        </Grid.RowDefinitions>

        <!-- Stream image -->
        <Image x:Name="StreamImage" Grid.Row="0"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality"/>

        <!-- No signal overlay -->
        <StackPanel x:Name="NoSignalPanel" Grid.Row="0"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="⏳" FontSize="48" HorizontalAlignment="Center"/>
            <TextBlock Text="Ожидание трансляции…"
                       FontSize="16" Foreground="#FF8E9297"
                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Controls bar -->
        <Border Grid.Row="1" Background="#DD000000">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleLabel" Text="…" FontSize="13"
                               Foreground="#FFDCDDDE" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Controls right side -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                    <!-- Mute toggle -->
                    <Button x:Name="MuteBtn"
                            Style="{StaticResource IconButton}"
                            Width="32" Height="32" Margin="0,0,4,0"
                            FontSize="15"
                            ToolTip="Заглушить стрим" Click="MuteBtn_Click"
                            Content="&#x1F50A;"/>
                    <!-- Expand to full window -->
                    <Button x:Name="ExpandBtn"
                            Style="{StaticResource IconButton}"
                            Width="32" Height="32" Margin="0,0,8,0"
                            FontSize="15"
                            ToolTip="Открыть отдельное окно" Click="ExpandBtn_Click"
                            Content="&#x26F6;"/>
                    <!-- Volume slider -->
                    <Slider x:Name="VolumeSlider"
                            Width="90" Minimum="0" Maximum="200" Value="100"
                            Style="{StaticResource DiscordSlider}"
                            VerticalAlignment="Center"
                            ValueChanged="VolumeSlider_Changed"/>
                    <TextBlock x:Name="VolLabel" Text="100%" FontSize="12"
                               Foreground="#FF8E9297" VerticalAlignment="Center" Margin="6,0,0,0" Width="36"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
